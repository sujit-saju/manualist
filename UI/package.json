{
  "name": "manualist-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fmt": "prettier --write .",
    "test": "vitest run --coverage",
    "gen:api": "openapi-typescript ../Server/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tailwindcss/vite": "^4",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^5",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-prettier": "^10",
    "eslint-plugin-jsx-a11y": "^6",
    "eslint-plugin-react-hooks": "^5",
    "jsdom": "^27",
    "openapi-typescript": "^7",
    "prettier": "^3",
    "tailwindcss": "^4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vite": "^7",
    "vitest": "^4"
  }
}
